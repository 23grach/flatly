{
  "name": "Flatly",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin for flattening selected layers.",
  "main": "code.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test",
    "verify": "npm run lint && npm test && node scripts/verify-release.cjs && git diff --check",
    "watch": "npm run build -- --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.132.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
